"""{{ name }}
Generated by RoboCraft - differential-drive rover (MicroPython)
Board:  {{ board_name }}
Driver: {{ driver_name }}
Motors: {{ motors }} x {{ motor_name }}

WIRING (full diagram in the RoboCraft Electronics tab)
{% for key, label in pin_labels.items() %}
  {{ "%-5s"|format(key|upper) }} -> {{ label }}
{% endfor %}
{% if control == "en_in" %}
  Remove the L298N's ENA/ENB jumpers so speed can be controlled with PWM.
{% endif %}

Keys in the serial console: w/s forward/back, a/d spin, x stop, p "{{ preset }}" demo{{ ", o obstacle avoidance" if sensor }}.
From the REPL: set_velocity(v, w), set_wheel_speeds(left, right), run_program(), stop_now()
"""
import select
import sys
import time

from machine import PWM, Pin{{ ", time_pulse_us" if sensor }}

# ---------------------------------------------------------------- geometry & limits
WHEEL_DIAMETER = {{ wheel_diameter|f(4) }}  # m
TRACK_WIDTH = {{ track_width|f(4) }}  # m, wheel to wheel
TOP_SPEED = {{ top_speed|f(3) }}  # m/s - your design target
MOTOR_MAX_SPEED = {{ motor_max_speed|f(3) }}  # m/s at 100% PWM (estimated from the motor curve)
MAX_ACCEL = {{ max_accel|f(3) }}  # m/s^2 - soft start/stop ramp
{% if sensor %}
STOP_DISTANCE_CM = {{ stop_cm|f(0) }}  # braking distance + margin
{% endif %}

# Flip one of these if a wheel spins backwards (or swap that motor's two wires).
LEFT_INVERT = False
RIGHT_INVERT = False

# ---------------------------------------------------------------- pins
{% if control == "en_in" %}
LEFT = (PWM(Pin({{ pins.ena }}), freq=1000), Pin({{ pins.in1 }}, Pin.OUT), Pin({{ pins.in2 }}, Pin.OUT))  # ENA, IN1, IN2
RIGHT = (PWM(Pin({{ pins.enb }}), freq=1000), Pin({{ pins.in3 }}, Pin.OUT), Pin({{ pins.in4 }}, Pin.OUT))  # ENB, IN3, IN4
{% elif control == "pwm_in_stby" %}
LEFT = (PWM(Pin({{ pins.pwma }}), freq=1000), Pin({{ pins.ain1 }}, Pin.OUT), Pin({{ pins.ain2 }}, Pin.OUT))  # PWMA, AIN1, AIN2
RIGHT = (PWM(Pin({{ pins.pwmb }}), freq=1000), Pin({{ pins.bin1 }}, Pin.OUT), Pin({{ pins.bin2 }}, Pin.OUT))  # PWMB, BIN1, BIN2
STBY = Pin({{ pins.stby }}, Pin.OUT, value=1)  # take the TB6612FNG out of standby
{% else %}
LEFT = (PWM(Pin({{ pins.pwm1 }}), freq=1000), Pin({{ pins.dir1 }}, Pin.OUT))  # PWM1, DIR1
RIGHT = (PWM(Pin({{ pins.pwm2 }}), freq=1000), Pin({{ pins.dir2 }}, Pin.OUT))  # PWM2, DIR2
{% endif %}
{% if sensor %}
TRIG = Pin({{ pins.trig }}, Pin.OUT, value=0)
ECHO = Pin({{ pins.echo }}, Pin.IN)
{% endif %}

# "{{ preset }}" demo: {{ preset_description }}. Identical to the RoboCraft simulation.
# (left m/s, right m/s, duration ms)
PROGRAM = [
{% for s in program %}
    ({{ s.left|f(3) }}, {{ s.right|f(3) }}, {{ s.ms }}),  # {{ s.label }}
{% endfor %}
]

state = {"target": [0.0, 0.0], "speed": [0.0, 0.0], "from": [0.0, 0.0], "ramp": 0.0,
         "start": time.ticks_ms(), "avoid": True}


def drive_motor(motor, speed, invert):
    forward = (speed >= 0) != invert
    duty = min(abs(speed) / MOTOR_MAX_SPEED, 1.0)
    pwm = int(duty * 65535)
{% if control == "pwm_dir" %}
    motor[1].value(1 if forward else 0)
{% else %}
    motor[1].value(1 if pwm and forward else 0)
    motor[2].value(1 if pwm and not forward else 0)
{% endif %}
    motor[0].duty_u16(pwm)


def set_wheel_speeds(left, right):
    """New wheel targets; both wheels ramp together so curvature stays constant."""
    speed = state["speed"]
    state["from"] = list(speed)
    state["target"] = [left, right]
    state["ramp"] = max(abs(left - speed[0]), abs(right - speed[1])) / MAX_ACCEL
    state["start"] = time.ticks_ms()


def update_motors():
    elapsed = time.ticks_diff(time.ticks_ms(), state["start"]) / 1000
    f = 1.0 if state["ramp"] <= 0 else min(elapsed / state["ramp"], 1.0)
    for i in range(2):
        state["speed"][i] = state["from"][i] + (state["target"][i] - state["from"][i]) * f
    drive_motor(LEFT, state["speed"][0], LEFT_INVERT)
    drive_motor(RIGHT, state["speed"][1], RIGHT_INVERT)


def set_velocity(v, w):
    """Differential-drive inverse kinematics: body speed v (m/s), turn rate w (rad/s)."""
    set_wheel_speeds(v - w * TRACK_WIDTH / 2, v + w * TRACK_WIDTH / 2)


def stop_now():
    state.update(target=[0.0, 0.0], speed=[0.0, 0.0], ramp=0.0)
    state["from"] = [0.0, 0.0]
    drive_motor(LEFT, 0, LEFT_INVERT)
    drive_motor(RIGHT, 0, RIGHT_INVERT)


{% if sensor %}
def read_distance_cm():
    TRIG.value(0)
    time.sleep_us(2)
    TRIG.value(1)
    time.sleep_us(10)
    TRIG.value(0)
    us = time_pulse_us(ECHO, 1, 30000)
    return 999.0 if us < 0 else us / 58.0


def obstacle_ahead():
    if not state["avoid"] or sum(state["target"]) <= 0:  # only when moving forward
        return False
    return read_distance_cm() < STOP_DISTANCE_CM


{% endif %}
def run_program():
    print("Running demo program...")
    for left, right, ms in PROGRAM:
        set_wheel_speeds(left, right)
        t0 = time.ticks_ms()
        while time.ticks_diff(time.ticks_ms(), t0) < ms:
            update_motors()
{% if sensor %}
            if obstacle_ahead():
                stop_now()
                print("Obstacle! Demo aborted.")
                return
{% endif %}
            time.sleep_ms(5)
    set_wheel_speeds(0, 0)
    print("Demo finished.")


def console():
    print("RoboCraft rover ready: w/s/a/d drive, x stop, p demo{{ ', o obstacle avoidance' if sensor }}")
    poller = select.poll()
    poller.register(sys.stdin, select.POLLIN)
    cruise = 0.6 * TOP_SPEED
    turn = 2 * 0.4 * TOP_SPEED / TRACK_WIDTH  # rad/s, spinning in place
{% if sensor %}
    last_check = time.ticks_ms()
{% endif %}
    while True:
        if poller.poll(0):
            c = sys.stdin.read(1).lower()
            if c == "w":
                set_velocity(cruise, 0)
            elif c == "s":
                set_velocity(-cruise, 0)
            elif c == "a":
                set_velocity(0, turn)
            elif c == "d":
                set_velocity(0, -turn)
            elif c == "x":
                set_wheel_speeds(0, 0)
            elif c == "p":
                run_program()
{% if sensor %}
            elif c == "o":
                state["avoid"] = not state["avoid"]
                print("Obstacle avoidance", "ON" if state["avoid"] else "OFF")
{% endif %}
        update_motors()
{% if sensor %}
        if time.ticks_diff(time.ticks_ms(), last_check) > 60:
            last_check = time.ticks_ms()
            if obstacle_ahead():
                stop_now()
                print("Obstacle ahead - stopped.")
{% endif %}
        time.sleep_ms(5)


stop_now()

if __name__ == "__main__":
    console()
