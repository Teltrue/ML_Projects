"""{{ name }}
Generated by RoboCraft - 3-axis servo arm with gripper (MicroPython)
Board: {{ board_name }}

WIRING (full diagram in the RoboCraft Electronics tab)
{% for s in servos %}
  {{ "%-16s"|format(s.label ~ " servo") }} signal -> {{ s.pin_label }}  ({{ s.name }})
{% endfor %}
  Servo power (red/brown) -> the {{ rail_v|f(1) }} V servo supply, NOT the board's power pins.
  Tie the servo supply GND to the board GND (common ground).

Use from the REPL, or type commands into the serial console:
  move_to(x, y, z)   move the gripper to x y z millimetres     (console: M x y z)
  set_joints(a, b, c) joint angles in degrees                   (console: J a b c)
  grip(True/False)   close / open the gripper                  (console: G 1 / G 0)
  run_demo()         pick-and-place demo                       (console: D)
  home()             home pose                                 (console: H)
"""
import math
import sys
import time

from machine import PWM, Pin

# ---------------------------------------------------------------- geometry (metres)
BASE_HEIGHT = {{ base_height|f(4) }}  # shoulder axis above the table
UPPER_ARM = {{ upper_arm|f(4) }}  # shoulder -> elbow
FOREARM = {{ forearm|f(4) }}  # elbow -> gripping point

# ---------------------------------------------------------------- pins (base, shoulder, elbow, gripper)
SERVO_PINS = ({{ servos | map(attribute="pin") | join(", ") }})
PULSE_MIN_US = ({{ servos | map(attribute="pulse_min") | join(", ") }})
PULSE_MAX_US = ({{ servos | map(attribute="pulse_max") | join(", ") }})

# ---------------------------------------------------------------- calibration
# servo angle = SERVO_OFFSET + SERVO_DIR * joint angle.
# If a joint moves the wrong way flip its SERVO_DIR; if it is off-centre nudge SERVO_OFFSET.
SERVO_OFFSET = ({{ offsets | map("f", 1) | join(", ") }})
SERVO_DIR = ({{ dirs | map("f", 1) | join(", ") }})
JOINT_MIN = ({% for lim in limits %}{{ lim[0]|f(1) }}{{ ", " if not loop.last }}{% endfor %})
JOINT_MAX = ({% for lim in limits %}{{ lim[1]|f(1) }}{{ ", " if not loop.last }}{% endfor %})
HOME_POSE = ({{ home | map("f", 1) | join(", ") }})
GRIPPER_OPEN = {{ gripper_open|f(1) }}  # gripper servo angle, degrees
GRIPPER_CLOSED = {{ gripper_closed|f(1) }}
MAX_SPEED = {{ max_speed|f(1) }}  # deg/s   (from your design)
MAX_ACCEL = {{ max_accel|f(1) }}  # deg/s^2 (from your design)

# Pick-and-place demo scaled to your arm's reach: (x, y, z mm, gripper closed, go home)
DEMO = [
{% for w in demo %}
    ({{ w.x|f(1) }}, {{ w.y|f(1) }}, {{ w.z|f(1) }}, {{ "True" if w.grip else "False" }}, {{ "True" if w.home else "False" }}),  # {{ w.label }}
{% endfor %}
]


class Servo:
    def __init__(self, pin, min_us, max_us):
        self.pwm = PWM(Pin(pin))
        self.pwm.freq(50)
        self.min_us = min_us
        self.max_us = max_us

    def write(self, angle):
        angle = min(max(angle, 0.0), 180.0)
        us = self.min_us + (self.max_us - self.min_us) * angle / 180.0
        self.pwm.duty_ns(int(us * 1000))


joints = [Servo(SERVO_PINS[j], PULSE_MIN_US[j], PULSE_MAX_US[j]) for j in range(3)]
gripper = Servo(SERVO_PINS[3], PULSE_MIN_US[3], PULSE_MAX_US[3])
current = list(HOME_POSE)
grip_closed = False


def wrap180(a):
    while a > 180.0:
        a -= 360.0
    while a <= -180.0:
        a += 360.0
    return a


def write_joints(q):
    for j in range(3):
        joints[j].write(SERVO_OFFSET[j] + SERVO_DIR[j] * q[j])


def limit_violation(q):
    v = 0.0
    for j in range(3):
        v += max(JOINT_MIN[j] - q[j], 0.0) + max(q[j] - JOINT_MAX[j], 0.0)
    return v


def solve_ik(x, y, z):
    """Closed-form IK (same maths as the RoboCraft simulator).

    Returns (joint angles in degrees, exact). Unreachable targets are projected onto the
    workspace boundary so the arm still points at them.
    """
    r = math.sqrt(x * x + y * y)
    s = z - BASE_HEIGHT
    dist = math.sqrt(r * r + s * s)
    reach_min = abs(UPPER_ARM - FOREARM)
    reach_max = UPPER_ARM + FOREARM
    reachable = reach_min - 1e-9 <= dist <= reach_max + 1e-9
    if r < 1e-9:
        options = [(current[0], 0.0)]
    else:
        yaw = math.degrees(math.atan2(y, x))
        options = [(yaw, r), (wrap180(yaw + 180.0), -r)]  # face it, or reach over the top

    best, best_key = None, None
    for yaw, rr in options:
        ss = s
        if not reachable:
            if dist < 1e-9:
                rr, ss = reach_min, 0.0
            else:
                scale = min(max(dist, reach_min), reach_max) / dist
                rr, ss = rr * scale, ss * scale
        c = (rr * rr + ss * ss - UPPER_ARM ** 2 - FOREARM ** 2) / (2 * UPPER_ARM * FOREARM)
        c = min(max(c, -1.0), 1.0)
        for elbow, sign in ((0, -1.0), (1, 1.0)):  # elbow up first
            t3 = sign * math.acos(c)
            t2 = math.atan2(ss, rr) - math.atan2(FOREARM * math.sin(t3),
                                                 UPPER_ARM + FOREARM * math.cos(t3))
            q = [wrap180(yaw), wrap180(math.degrees(t2)), wrap180(math.degrees(t3))]
            if elbow == 0 and q[2] == 180.0:
                q[2] = -180.0
            violation = limit_violation(q)
            motion = sum(abs(q[j] - current[j]) for j in range(3))
            key = (violation > 1e-6, violation, elbow, motion)
            if best_key is None or key < best_key:
                best, best_key = q, key
    q = [min(max(best[j], JOINT_MIN[j]), JOINT_MAX[j]) for j in range(3)]
    return q, reachable and not best_key[0]


def forward_kinematics(q):
    t1, t2, t23 = math.radians(q[0]), math.radians(q[1]), math.radians(q[1] + q[2])
    r = UPPER_ARM * math.cos(t2) + FOREARM * math.cos(t23)
    return (r * math.cos(t1), r * math.sin(t1),
            BASE_HEIGHT + UPPER_ARM * math.sin(t2) + FOREARM * math.sin(t23))


def move_joints(target):
    """Smooth quintic joint move that respects MAX_SPEED and MAX_ACCEL."""
    start = list(current)
    delta = max(abs(target[j] - start[j]) for j in range(3))
    duration = max(1.875 * delta / MAX_SPEED, math.sqrt(5.7735 * delta / MAX_ACCEL))
    t0 = time.ticks_ms()
    while True:
        tau = 1.0 if duration <= 0 else min(time.ticks_diff(time.ticks_ms(), t0) / 1000 / duration, 1.0)
        blend = tau ** 3 * (10 + tau * (-15 + 6 * tau))
        for j in range(3):
            current[j] = start[j] + (target[j] - start[j]) * blend
        write_joints(current)
        if tau >= 1.0:
            break
        time.sleep_ms(15)


def move_to(x_mm, y_mm, z_mm):
    q, ok = solve_ik(x_mm / 1000, y_mm / 1000, z_mm / 1000)
    if not ok:
        print("! Target out of reach - moving as close as possible")
    move_joints(q)
    return ok


def set_joints(a, b, c):
    move_joints([min(max(v, JOINT_MIN[j]), JOINT_MAX[j]) for j, v in enumerate((a, b, c))])


def grip(closed):
    global grip_closed
    if closed == grip_closed:
        return
    gripper.write(GRIPPER_CLOSED if closed else GRIPPER_OPEN)
    grip_closed = closed
    time.sleep_ms(400)


def home():
    move_joints(list(HOME_POSE))


def run_demo():
    for x, y, z, closed, go_home in DEMO:
        if go_home:
            home()
        else:
            move_to(x, y, z)
        grip(closed)


def print_pose():
    p = forward_kinematics(current)
    print("joints (deg): %.1f, %.1f, %.1f   gripper tip (mm): %.1f, %.1f, %.1f   [%s]"
          % (current[0], current[1], current[2], p[0] * 1000, p[1] * 1000, p[2] * 1000,
             "closed" if grip_closed else "open"))


def console():
    print("RoboCraft arm ready. Commands: M x y z | J a b c | G 0/1 | D | H | P")
    print_pose()
    while True:
        parts = sys.stdin.readline().strip().split()
        if not parts:
            continue
        try:
            cmd, args = parts[0].upper(), [float(a) for a in parts[1:]]
            if cmd == "M" and len(args) == 3:
                move_to(*args)
            elif cmd == "J" and len(args) == 3:
                set_joints(*args)
            elif cmd == "G" and args:
                grip(args[0] != 0)
            elif cmd == "D":
                run_demo()
            elif cmd == "H":
                home()
            print_pose()
        except Exception as exc:  # keep the console alive on typos
            print("error:", exc)


write_joints(current)
gripper.write(GRIPPER_OPEN)

if __name__ == "__main__":
    console()
