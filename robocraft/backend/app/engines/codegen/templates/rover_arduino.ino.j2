/*
 * {{ name }}
 * Generated by RoboCraft - differential-drive rover
 * Board:  {{ board_name }}
 * Driver: {{ driver_name }}
 * Motors: {{ motors }} x {{ motor_name }}
 *
 * WIRING (full diagram in the RoboCraft Electronics tab)
{% for key, label in pin_labels.items() %}
 *   {{ "%-5s"|format(key|upper) }} -> {{ label }}
{% endfor %}
{% if control == "en_in" %}
 *   Remove the L298N's ENA/ENB jumpers so speed can be controlled with PWM.
{% endif %}
 *
 * SERIAL COMMANDS (115200 baud)
 *   w / s   drive forward / backward       a / d   spin left / right
 *   x       stop                           p       run the "{{ preset }}" demo program
{% if sensor %}
 *   o       toggle obstacle avoidance (stops {{ stop_cm|f(0) }} cm from obstacles)
{% endif %}
 */
#include <math.h>

// ---------------------------------------------------------------- geometry & limits
const float WHEEL_DIAMETER  = {{ wheel_diameter|f(4) }};  // m
const float TRACK_WIDTH     = {{ track_width|f(4) }};  // m, wheel to wheel
const float TOP_SPEED       = {{ top_speed|f(3) }};   // m/s - your design target
const float MOTOR_MAX_SPEED = {{ motor_max_speed|f(3) }};   // m/s at 100% PWM (estimated from the motor curve)
const float MAX_ACCEL       = {{ max_accel|f(3) }};   // m/s^2 - soft start/stop ramp

// ---------------------------------------------------------------- pins
{% if control == "en_in" %}
const int PIN_ENA = {{ pins.ena }}, PIN_IN1 = {{ pins.in1 }}, PIN_IN2 = {{ pins.in2 }};  // left motor
const int PIN_ENB = {{ pins.enb }}, PIN_IN3 = {{ pins.in3 }}, PIN_IN4 = {{ pins.in4 }};  // right motor
{% elif control == "pwm_in_stby" %}
const int PIN_PWMA = {{ pins.pwma }}, PIN_AIN1 = {{ pins.ain1 }}, PIN_AIN2 = {{ pins.ain2 }};  // left motor
const int PIN_PWMB = {{ pins.pwmb }}, PIN_BIN1 = {{ pins.bin1 }}, PIN_BIN2 = {{ pins.bin2 }};  // right motor
const int PIN_STBY = {{ pins.stby }};
{% else %}
const int PIN_PWM1 = {{ pins.pwm1 }}, PIN_DIR1 = {{ pins.dir1 }};  // left motor
const int PIN_PWM2 = {{ pins.pwm2 }}, PIN_DIR2 = {{ pins.dir2 }};  // right motor
{% endif %}
{% if sensor %}
const int PIN_TRIG = {{ pins.trig }}, PIN_ECHO = {{ pins.echo }};
const float STOP_DISTANCE_CM = {{ stop_cm|f(0) }};  // braking distance + margin
{% endif %}

// Flip one of these if a wheel spins backwards (or swap that motor's two wires).
const bool LEFT_INVERT = false;
const bool RIGHT_INVERT = false;

float targetL = 0, targetR = 0;      // requested wheel speeds, m/s
float speedL = 0, speedR = 0;        // ramped speeds actually applied
float rampFromL = 0, rampFromR = 0;
float rampTime = 0;                  // s
unsigned long rampStart = 0;
bool avoidObstacles = true;

void driveMotor(bool left, float speed) {
  bool forward = speed >= 0;
  if (left ? LEFT_INVERT : RIGHT_INVERT) forward = !forward;
  float duty = fabs(speed) / MOTOR_MAX_SPEED;
  if (duty > 1.0f) duty = 1.0f;
  int pwm = (int)(duty * 255.0f + 0.5f);
{% if control == "en_in" %}
  int en = left ? PIN_ENA : PIN_ENB;
  int a = left ? PIN_IN1 : PIN_IN3;
  int b = left ? PIN_IN2 : PIN_IN4;
  digitalWrite(a, (pwm > 0 && forward) ? HIGH : LOW);
  digitalWrite(b, (pwm > 0 && !forward) ? HIGH : LOW);
  analogWrite(en, pwm);
{% elif control == "pwm_in_stby" %}
  int en = left ? PIN_PWMA : PIN_PWMB;
  int a = left ? PIN_AIN1 : PIN_BIN1;
  int b = left ? PIN_AIN2 : PIN_BIN2;
  digitalWrite(a, (pwm > 0 && forward) ? HIGH : LOW);
  digitalWrite(b, (pwm > 0 && !forward) ? HIGH : LOW);
  analogWrite(en, pwm);
{% else %}
  digitalWrite(left ? PIN_DIR1 : PIN_DIR2, forward ? HIGH : LOW);
  analogWrite(left ? PIN_PWM1 : PIN_PWM2, pwm);
{% endif %}
}

// New wheel targets. Both wheels ramp together, so curvature stays constant while
// accelerating - exactly what the RoboCraft simulator models.
void setWheelSpeeds(float left, float right) {
  rampFromL = speedL;
  rampFromR = speedR;
  targetL = left;
  targetR = right;
  float change = fabs(left - speedL);
  if (fabs(right - speedR) > change) change = fabs(right - speedR);
  rampTime = change / MAX_ACCEL;
  rampStart = millis();
}

void updateMotors() {
  float f = rampTime > 0 ? (millis() - rampStart) / 1000.0f / rampTime : 1.0f;
  if (f > 1.0f) f = 1.0f;
  speedL = rampFromL + (targetL - rampFromL) * f;
  speedR = rampFromR + (targetR - rampFromR) * f;
  driveMotor(true, speedL);
  driveMotor(false, speedR);
}

// Differential-drive inverse kinematics: body speed v (m/s) and turn rate w (rad/s).
void setVelocity(float v, float w) {
  setWheelSpeeds(v - w * TRACK_WIDTH / 2.0f, v + w * TRACK_WIDTH / 2.0f);
}

void stopNow() {
  targetL = targetR = speedL = speedR = rampFromL = rampFromR = 0;
  rampTime = 0;
  driveMotor(true, 0);
  driveMotor(false, 0);
}

{% if sensor %}
float readDistanceCm() {
  digitalWrite(PIN_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(PIN_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(PIN_TRIG, LOW);
  unsigned long us = pulseIn(PIN_ECHO, HIGH, 30000UL);
  return us == 0 ? 999.0f : us / 58.0f;
}

bool obstacleAhead() {
  if (!avoidObstacles || targetL + targetR <= 0) return false;  // only when moving forward
  return readDistanceCm() < STOP_DISTANCE_CM;
}

{% endif %}
struct Step {
  float left, right;  // wheel speeds, m/s
  unsigned long ms;
};

// "{{ preset }}" demo: {{ preset_description }}.
// Identical to the RoboCraft simulation.
const Step PROGRAM[] = {
{% for s in program %}
  { {{ s.left|f(3) }}, {{ s.right|f(3) }}, {{ s.ms }} },  // {{ s.label }}
{% endfor %}
};
const int PROGRAM_LEN = sizeof(PROGRAM) / sizeof(PROGRAM[0]);

void runProgram() {
  Serial.println(F("Running demo program..."));
  for (int i = 0; i < PROGRAM_LEN; i++) {
    setWheelSpeeds(PROGRAM[i].left, PROGRAM[i].right);
    unsigned long t0 = millis();
    while (millis() - t0 < PROGRAM[i].ms) {
      updateMotors();
{% if sensor %}
      if (obstacleAhead()) {
        stopNow();
        Serial.println(F("Obstacle! Demo aborted."));
        return;
      }
{% endif %}
      delay(5);
    }
  }
  setWheelSpeeds(0, 0);
  Serial.println(F("Demo finished."));
}

void setup() {
  Serial.begin(115200);
{% if control == "en_in" %}
  int outputs[] = { PIN_ENA, PIN_IN1, PIN_IN2, PIN_ENB, PIN_IN3, PIN_IN4 };
{% elif control == "pwm_in_stby" %}
  int outputs[] = { PIN_PWMA, PIN_AIN1, PIN_AIN2, PIN_PWMB, PIN_BIN1, PIN_BIN2, PIN_STBY };
{% else %}
  int outputs[] = { PIN_PWM1, PIN_DIR1, PIN_PWM2, PIN_DIR2 };
{% endif %}
  for (unsigned int i = 0; i < sizeof(outputs) / sizeof(outputs[0]); i++) pinMode(outputs[i], OUTPUT);
{% if control == "pwm_in_stby" %}
  digitalWrite(PIN_STBY, HIGH);  // take the TB6612FNG out of standby
{% endif %}
{% if sensor %}
  pinMode(PIN_TRIG, OUTPUT);
  pinMode(PIN_ECHO, INPUT);
{% endif %}
  stopNow();
  Serial.println(F("RoboCraft rover ready: w/s/a/d drive, x stop, p demo{{ ', o obstacle avoidance' if sensor }}"));
}

unsigned long lastCheck = 0;

void loop() {
  if (Serial.available()) {
    char c = tolower(Serial.read());
    float cruise = 0.6f * TOP_SPEED;
    float turn = 2.0f * 0.4f * TOP_SPEED / TRACK_WIDTH;  // rad/s, spinning in place
    if (c == 'w') setVelocity(cruise, 0);
    else if (c == 's') setVelocity(-cruise, 0);
    else if (c == 'a') setVelocity(0, turn);
    else if (c == 'd') setVelocity(0, -turn);
    else if (c == 'x') setWheelSpeeds(0, 0);
    else if (c == 'p') runProgram();
{% if sensor %}
    else if (c == 'o') {
      avoidObstacles = !avoidObstacles;
      Serial.println(avoidObstacles ? F("Obstacle avoidance ON") : F("Obstacle avoidance OFF"));
    }
{% endif %}
  }
  updateMotors();
{% if sensor %}
  if (millis() - lastCheck > 60) {
    lastCheck = millis();
    if (obstacleAhead()) {
      stopNow();
      Serial.println(F("Obstacle ahead - stopped."));
    }
  }
{% endif %}
  delay(5);
}
